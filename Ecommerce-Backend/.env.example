DB_URL=jdbc:mysql://localhost:3306/ecomdb
DB_USERNAME=ecom_user
DB_PASSWORD=replace-with-your-db-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
# Optional; only set these together to create a named admin account:
ADMIN_USERNAME=storeadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
